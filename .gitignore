# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets & environment
.env
.env.*
!.env.example

# Local data & databases (raw market data, SQLite files)
#
# data/ is ignored because it holds downloaded market data and local databases,
# which are inputs and byproducts, not source. One thing under it IS source: the
# versioned seed bundle that core/seed_ingest.py loads and tests/test_seed_ingest.py
# asserts against. Git cannot re-include a file whose parent directory is
# excluded, so the rule ignores data's *children* and re-includes the seed dir
# explicitly. Without this, a fresh clone ships a seeder that cannot load its
# own data and a test that fails on a missing file.
data/*
!data/seed/
data/seed/*
!data/seed/*.json
# The golden datasets are the exception that proves the rule. They are
# regenerable byte-stable from simulation/generate_golden_data.py (seed=42), but
# the Dockerfile COPYs data/golden, docker-compose mounts it read-only, and
# scripts/run_replay.py defaults to it -- so a fresh clone without them cannot
# build the image or replay anything. Versioned because a fixture a build
# depends on is source, and because "regenerate it first" is a step every
# consumer would otherwise have to rediscover.
!data/golden/
data/golden/*
!data/golden/*.csv
*.db
*.sqlite3

# Local runtime logs (serve/frontend transcripts; machine noise, never evidence.
# Durable evidence belongs under .evidence/, which is ignored on purpose too —
# a log is not a record, and shipping one invites reading it as one.)
logs/
*.log
*.err.log

# Local tooling and verification artifacts (nats-server binary, junit/xml evidence)
.tools/
.evidence/

# Vendored study clones (reference repos inspected, not part of the build)
.vt-study/

# OS noise
Thumbs.db
.DS_Store

# OneDrive sync placeholders can conflict with git index; ignore office temp files
~$*
