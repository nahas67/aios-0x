# AIOS-0X environment example - copy to .env and fill in real values.
# NEVER commit .env. The system runs in deterministic mode when keys are absent.

# Choose: none | openai | openai_compatible | anthropic
MODEL_PROVIDER=none

# Provider credentials (only the one matching MODEL_PROVIDER is used)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional OpenAI-compatible endpoint override (DeepSeek, Together, local vLLM...)
OPENAI_BASE_URL=https://api.openai.com/v1

# Model routing
RESEARCH_MODEL_CHEAP=gpt-4o-mini
RESEARCH_MODEL_REASONING=gpt-4o
VERIFICATION_MODEL=gpt-4o-mini

# auto | deterministic
RESEARCH_MODE=auto

# Data tier: leave empty for local SQLite; set a postgres DSN to promote
# persistence to the PostgreSQL Data & State Plane (requires psycopg).
DATABASE_URL=
# e.g. DATABASE_URL=postgresql://aios:secret@localhost:5432/aios
