# AIOS-0X environment example - copy to .env and fill in real values.
# NEVER commit .env. The system runs in deterministic mode when keys are absent.

MODEL_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

RESEARCH_MODEL_CHEAP=gpt-4o-mini
RESEARCH_MODEL_REASONING=gpt-4o
VERIFICATION_MODEL=gpt-4o-mini

# Safe default. AUTONOMOUS requires an explicit operator action after startup.
AUTONOMY_MODE=SUPERVISED
RESEARCH_MODE=auto
DATABASE_URL=

# Authentication is server-owned. When set, use Authorization: Bearer <token>.
# The token's role is configured only by the server, never by a request body.
# API_AUTH_TOKEN=
# AIOS_OPERATOR_ID=principal
# AIOS_DEFAULT_ROLE=VIEWER
# Optional JSON map: {"token-a":{"operator_id":"alice","role":"OPERATOR"}}
# AIOS_TOKEN_MAP=

# Execution is paper/shadow by default. Credentials alone never enable live routing.
AIOS_ALLOW_LIVE_EXECUTION=0
AIOS_EXCHANGE_TESTNET=1
# AIOS_EXCHANGE_API_KEY=
# AIOS_EXCHANGE_SECRET=

# Optional market/news providers; only status is shown in the UI.
# FINNHUB_API_KEY=
# GNEWS_API_KEY=
# NEWSDATA_API_KEY=
# MARKETSTACK_API_KEY=
# FRED_API_KEY=

# Optional notifications.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
