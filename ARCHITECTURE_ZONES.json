  "planes_spanning_zones": {
    "$comment": "Recorded because it is the finding, not a defect to be tidied away. The manifest's planes are capability groupings and the architecture's zones are trust groupings, so they are orthogonal by construction. Five of the eight straddle -- Data & State spans all four plus SHARED. Single-zone planes are deliberately absent: the list is for straddlers only, so adding one is a signal rather than a no-op.",
    "Research": ["C", "SHARED"],
    "Execution": ["A", "B"],
    "Deterministic Authority": ["A", "B", "D"],
    "Data & State": ["A", "B", "C", "D"],
    "Infrastructure": ["C", "D", "SHARED"]
  },

  "zone_rule_exceptions": [
    {
      "importer": "communities/c4_strategy/strategy_agent.py",
      "imports": "core.risk_firewall",
      "kind": "type-only; instance injected by a composition root and never constructed here",
      "justification": "ARCHITECTURE.txt section 7 forbids an AI zone from ACCESSING CAPITAL CREDENTIALS. strategy_agent.py imports RiskFirewall solely to annotate a constructor parameter and calls evaluate_strategy on the injected instance; it holds no credential, constructs nothing, and cannot escalate. The rule's intent holds and its letter does not. The proper closure is the shape this manifest already prescribes for ToolGuard -- extract the interface to schemas/ and depend on that instead of the Zone A concrete. Recorded as data rather than suppressed in the test, so it stays visible and countable, and so any NEW violation still fails."
    }
